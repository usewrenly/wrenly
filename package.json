{
  "name": "wrenly",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "recover-password": "bun run --cwd apps/api recover-password",
    "reconcile-deployment": "bun run --cwd apps/api reconcile-deployment"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/agents/*"
  ]
}
