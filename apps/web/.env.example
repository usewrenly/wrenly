# Required HTTP(S) API origin for the server-side /api proxy (no path or credentials).
# Browser requests stay on the web origin; this address must be reachable by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Required HTTP(S) web origin used by Better Auth (no credentials, path, query or fragment).
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Optional docs entry URL. Development defaults to http://localhost:3001/docs.
# Set explicitly for production; a local docs deployment works without internet.
# HTTPS required except local/LAN HTTP. No credentials, query or fragment.
# NEXT_PUBLIC_DOCS_URL=https://YOUR_DOCS_HOST/docs
