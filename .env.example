# Wrenly instance configuration — repository root only.
# Copy to .env. API commands and database migrations read this file.
# Never commit .env. Configure model connections in Settings → Providers after sign-in.
# Web public addresses: apps/web/.env.example. Documentation: apps/docs/.env.example.

# Required: local development PostgreSQL from docker-compose.dev.yml.
# Production: use your private PostgreSQL connection, not these development credentials.
WRENLY_DATABASE_URL=postgresql://wrenly:wrenly_dev@localhost:65432/wrenly
# Required: generate once with openssl rand -base64 32. Keep it private and stable.
WRENLY_AUTH_SECRET=
# API and browser origins, without paths. Every instance requires sign-in.
WRENLY_APP_URL=http://localhost:3002
WRENLY_WEB_URL=http://localhost:3000
WRENLY_API_HOST=127.0.0.1
WRENLY_API_PORT=3002

# Private persistent files, including encryption keys. Back up with PostgreSQL.
# Relative to apps/api when using its package commands; preserve on upgrades.
# WRENLY_DATA_DIR=.local/wrenly

# Docker validation limits. Generated code never runs directly on the host.
WRENLY_SANDBOX_MEMORY_LIMIT=2048m
WRENLY_SANDBOX_CPU_LIMIT=2
WRENLY_SANDBOX_TIMEOUT_SECONDS=300
# Model request deadline, 30–600 seconds; separate from Docker validation.
WRENLY_MODEL_TIMEOUT_SECONDS=180

# Optional local previews: finish the preview setup guide before enabling.
# See apps/docs/content/docs/guides/local-previews.mdx.
WRENLY_PREVIEW_ENABLED=false
WRENLY_PREVIEW_BASE_URL=http://wrenly-preview.localhost:3003
WRENLY_PREVIEW_GATEWAY_PORT=3003
# Experimental Development databases require previews and trusted database toolchains.
# Production databases and database-backed publishing are not available.
WRENLY_APP_DATABASES_ENABLED=false

# Optional publishing: finish the private publishing guide before enabling.
# See apps/docs/content/docs/guides/private-publishing.mdx.
WRENLY_PUBLISHING_ENABLED=false
# Generate once: openssl rand -hex 32. Keep separate from the auth secret and backed up.
# WRENLY_DEPLOY_ENCRYPTION_KEY=
# Private Git host origin and repository-creation token.
# WRENLY_GIT_BASE_URL=http://127.0.0.1:3030
# WRENLY_GIT_TOKEN=
# WRENLY_GIT_ORG=wrenly-apps
# Private registry origin and matching push/pull credentials.
# WRENLY_REGISTRY_URL=http://127.0.0.1:5001
# WRENLY_REGISTRY_NAMESPACE=wrenly
# WRENLY_REGISTRY_USERNAME=wrenly
# WRENLY_REGISTRY_PASSWORD=
# Coolify API address, token and target identifiers from its dashboard.
# WRENLY_COOLIFY_API_URL=http://127.0.0.1:8000/api/v1
# WRENLY_COOLIFY_API_KEY=
# WRENLY_COOLIFY_PROJECT_UUID=
# WRENLY_COOLIFY_SERVER_UUID=
# WRENLY_COOLIFY_ENVIRONMENT=production

# Advanced: environment-managed providers instead of dashboard connections.
# Leave unset for guided setup. Use only the connection you actually need.
# WRENLY_MODEL_BASE_URL=http://localhost:11434/v1
# WRENLY_MODEL_API_KEY=ollama
# WRENLY_MODEL_NAME=YOUR_INSTALLED_MODEL
# WRENLY_GROQ_API_KEY=
# WRENLY_OPENAI_API_KEY=
# WRENLY_OLLAMA_URL=http://localhost:11434
# Test-only settings belong in the relevant package tests/README.md, not instance setup.
